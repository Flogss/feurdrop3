TELEGRAM_BOT_TOKEN=8957997002:AAEzvJXgMZ9Qn7E4ERirZHTrTfseF8WDKm4
PORT=3000
# En local uniquement. Sur Railway, NE PAS definir DB_PATH : le volume monte
# est utilise automatiquement, sinon la base est perdue a chaque deploiement.
DB_PATH=./data/drop.db
DEFAULT_PRICE=4
DEFAULT_LIT_PRICE=5.5
DEFAULT_BJ_PRICE=4
BATCH_DEBOUNCE_MS=3000
# Jeton partage avec l'agent d'impression du Mac (agent/README.md). Genere
# automatiquement au premier demarrage et affiche dans les logs si absent.
# PRINT_TOKEN=
# Format de l'imprimante thermique, en points PDF (288x432 = 4x6 pouces).
# LABEL_WIDTH_PT=288
# LABEL_HEIGHT_PT=432
# Largeur du rouleau pour les LIT (papier fax 210 mm).
# ROLL_WIDTH_MM=210
# SMIC horaire NET servant de comparaison apres une tournee (~9,40 EUR net,
# pour 11,88 EUR brut depuis novembre 2024). A mettre a jour a chaque
# revalorisation.
SMIC_HOURLY=9.4
# Notifications push : les cles VAPID sont generees automatiquement au premier
# demarrage et stockees en base. Ne les renseigner que pour les figer soi-meme
# (les changer invalide tous les abonnements existants).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PUSH_CONTACT=https://feurdrop3-production.up.railway.app
# Onglet Plan (tournees de depot) : aucune cle n'est necessaire. Les adresses
# sont geocodees par la Base Adresse Nationale, les bureaux de poste et leurs
# heures limites de depot viennent de l'open data de La Poste, et les points
# relais des autres reseaux d'OpenStreetMap. Les trois sont gratuits et sans
# compte.
# FedEx (developer.fedex.com) : necessaire uniquement pour trouver les points
# de depot FedEx. Sans ces deux valeurs, la source reste eteinte et le dit.
# FEDEX_API_KEY=
# FEDEX_API_SECRET=
# UPS (developer.ups.com) : necessaire uniquement pour trouver les UPS Access
# Points. Sans ces deux valeurs, la source reste eteinte et le dit.
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
# DHL (developer.dhl.com, "Location Finder") : necessaire uniquement pour
# trouver les Service Points DHL. Sans cette valeur, la source reste eteinte.
# DHL_API_KEY=
# Base du bot de suivi (projet suivi-colissimo), lue en SEULE LECTURE par
# l'onglet "Suivi des colis". Sans elle, l'onglet le dit et le reste du site
# fonctionne normalement. En local, le projet voisin est trouve tout seul.
# SUIVI_DB_PATH=/Users/flogas/Documents/suivi/data/suivi.db
# --- Bot de suivi des numeros (suivi-colissimo) --------------------------
# Demarre par ce serveur quand les trois variables sont la ; sinon il reste
# en veille et l'onglet Suivi le dit. Le jeton est celui d'un SECOND bot,
# different de TELEGRAM_BOT_TOKEN. Un meme jeton ne peut pas etre interroge
# depuis deux machines a la fois.
# SUIVI_BOT_TOKEN=
# OKAPI_KEY=
# SUIVI_ALLOWED_CHATS=8925708293
# Topic "Special" du groupe de travail : le nombre a la fin du lien
# t.me/c/<groupe>/<N>. Sans lui, un fichier classe "special" reste dans la
# conversation privee au lieu de partir dans son topic.
# SPECIAL_TOPIC_ID=
